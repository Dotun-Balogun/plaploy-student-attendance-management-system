# Supabase project URL (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase "publishable" key (Project Settings -> API -> Publishable key).
# This is the modern replacement for the legacy "anon" key and is safe to
# expose to the browser — access is governed by the RLS policies in
# supabase/schema.sql, not by this key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Supabase "secret" key (Project Settings -> API -> Secret keys). This is the
# modern replacement for the legacy "service_role" key. It bypasses RLS and
# must NEVER be prefixed with NEXT_PUBLIC_ or shipped to the browser — it is
# only read on the server, by lib/supabase/admin.ts, to create auth accounts
# for new students and lecturers from the admin panel.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# A shared secret an administrator must type into the "Admin" tab of /signup
# to self-register as an administrator. Anyone without this code who selects
# the Admin tab will be rejected server-side — pick something private and
# only share it with people who should have admin access. Not needed if
# you'll only ever create admins by hand in Supabase (see the README).
ADMIN_SIGNUP_CODE=change-this-before-deploying

